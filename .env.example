# Meta Pixel. Lido no servidor (layout) e passado ao cliente por props. Vazio = desligado.
META_PIXEL_ID=

# Meta Conversions API (server-side). NUNCA expor no cliente.
META_CAPI_TOKEN=

# Código de evento de teste do Events Manager (só em dev/staging).
META_TEST_EVENT_CODE=

# Microsoft Clarity (gravações e mapas de calor). Lido no servidor. Vazio = desligado.
CLARITY_ID=
